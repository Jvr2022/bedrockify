    "build": "node scripts/build.mjs",
    "assets": "node scripts/assets.mjs"
  },
  "devDependencies": {
    "less": "^4.9.1",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jvr2022/bedrockify.git"
  },
  "homepage": "https://github.com/jvr2022/bedrockify",
