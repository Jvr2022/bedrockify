{
  "name": "bedrockify",
  "version": "0.1.0",
  "private": true,
  "description": "Minecraft Bedrock Ore UI userstyles",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "prettier --check . && node scripts/assets.mjs --check && npm run build && node scripts/check-styles.mjs",
